{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@testado/shared": ["packages/shared/src/index.ts"],
      "@testado/shared/*": ["packages/shared/src/*"],
      "@testado/pdf-core": ["packages/pdf-core/src/index.ts"],
      "@testado/pdf-core/*": ["packages/pdf-core/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
